<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio Avanzado de Pociones - Cátedra Snape</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        /* Estilos de la Interfaz del Laboratorio (Pantalla) */
        body {
            background-color: #060c08;
            color: #d1f2eb;
            font-family: 'Times New Roman', Times, serif;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .interface-container {
            background-color: #0c1811;
            border: 2px solid #1c4d32;
            box-shadow: 0 0 20px rgba(28, 77, 50, 0.5);
            border-radius: 8px;
            width: 100%;
            max-width: 700px;
            padding: 25px;
            text-align: center;
        }

        h1 {
            color: #ffffff;
            font-size: 22pt;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 5px;
            border-bottom: 1px solid #1c4d32;
            padding-bottom: 10px;
        }

        .sub-header {
            font-style: italic;
            color: #89bfa0;
            font-size: 11pt;
            margin-bottom: 15px;
        }

        .stats-bar {
            background-color: #050f0a;
            border: 1px solid #163e28;
            padding: 8px;
            border-radius: 4px;
            font-size: 10.5pt;
            margin-bottom: 20px;
            color: #52be80;
            font-weight: bold;
        }

        /* El Caldero Visual */
        .caldero-display {
            width: 160px;
            height: 160px;
            background: radial-gradient(circle at 30% 30%, #2c3e50, #0f171e);
            border: 6px solid #7f8c8d;
            border-radius: 50% 50% 45% 45%;
            margin: 20px auto;
            position: relative;
            box-shadow: inset 0 0 20px #000;
            transition: all 0.5s ease;
        }

        .liquid {
            position: absolute;
            top: 25px;
            left: 15px;
            right: 15px;
            bottom: 20px;
            background-color: transparent;
            border-radius: 50%;
            transition: background-color 0.8s ease, box-shadow 0.8s ease;
        }

        .liquid.agua { background-color: #3498db; box-shadow: inset 0 0 15px #2980b9; }
        .liquid.hongo { background-color: #7f8c8d; box-shadow: inset 0 0 15px #616a6b; }
        .liquid.esmeralda { background-color: #2ecc71; box-shadow: inset 0 0 25px #27ae60, 0 0 15px #2ecc71; }
        
        .fire-burner {
            width: 80px;
            height: 15px;
            background-color: #555;
            margin: 0 auto;
            border-radius: 3px;
            transition: background-color 0.3s;
        }
        .fire-burner.on { background-color: #e67e22; box-shadow: 0 5px 15px #e67e22; }

        /* Consola de Mensajes */
        .console-box {
            background-color: #030805;
            border: 1px solid #1c4d32;
            font-family: monospace;
            padding: 15px;
            text-align: left;
            border-radius: 4px;
            height: 110px;
            overflow-y: auto;
            margin-bottom: 25px;
            color: #48c9b0;
            font-size: 10pt;
        }

        /* Botonera */
        .controls-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        button {
            background-color: #092314;
            border: 1px solid #1c4d32;
            color: #e5f0ea;
            padding: 12px;
            font-family: 'Times New Roman', Times, serif;
            font-size: 11pt;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.3s;
        }

        button:hover {
            background-color: #1c4d32;
            color: #ffffff;
            box-shadow: 0 0 8px rgba(72, 201, 176, 0.4);
        }

        button:disabled {
            background-color: #050a06;
            border-color: #0b1a11;
            color: #44554a;
            cursor: not-allowed;
            box-shadow: none;
        }

        .btn-action {
            background-color: #7d6608;
            border-color: #9a7d0a;
            color: #ffffff;
        }
        
        .btn-action:hover {
            background-color: #9a7d0a;
        }

        /* Interfaz en caso de error catastrófico */
        .interface-container.implosion {
            border-color: #922b21;
            box-shadow: 0 0 25px #922b21;
        }
        .interface-container.implosion .caldero-display {
            background: #2c3e50;
            border-color: #c0392b;
            transform: scale(0.9) rotate(5deg);
        }
        .interface-container.implosion .liquid {
            background-color: #922b21 !important;
            box-shadow: 0 0 30px #c0392b !important;
        }

        /* =========================================================
           ESTILOS ESPECÍFICOS PARA EL PERGAMINO PDF (OCULTO EN WEB)
           ========================================================= */
        #pdf-template {
            display: none;
            background-color: #0d1611;
            color: #e2ece7;
            font-family: 'Times New Roman', Times, serif;
            padding: 35px;
            border: 5px double #1e5c35;
            width: 620px;
            margin: 0 auto;
        }

        .pdf-header {
            text-align: center;
            border-bottom: 2px solid #1e5c35;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .pdf-title {
            font-size: 20pt;
            font-weight: bold;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin: 0;
        }

        .pdf-subtitle {
            font-size: 11pt;
            font-style: italic;
            color: #8fa89b;
            margin: 5px 0 0 0;
        }

        .pdf-section {
            margin-bottom: 20px;
            font-size: 12pt;
        }

        .pdf-field {
            margin-bottom: 12px;
            border-bottom: 1px dashed #1c4d32;
            padding-bottom: 6px;
        }

        .pdf-label {
            font-weight: bold;
            color: #52be80;
            text-transform: uppercase;
            font-size: 10pt;
            display: inline-block;
            width: 220px;
        }

        .pdf-value {
            color: #ffffff;
        }

        .pdf-dictamen {
            background-color: #072211;
            border-left: 4px solid #52be80;
            padding: 15px;
            margin-top: 30px;
            font-style: italic;
            text-align: justify;
            line-height: 1.5;
        }

        .pdf-dictamen.fail {
            background-color: #240a07;
            border-left-color: #ec7063;
        }

        .pdf-footer {
            margin-top: 50px;
            text-align: center;
            font-size: 9.5pt;
            color: #617c6e;
            border-top: 1px solid #1e5c35;
            padding-top: 12px;
        }
    </style>
</head>
<body>

    <div class="interface-container" id="lab-interface">
        <h1>Mesa de Destilación Alquímica</h1>
        <div class="sub-header">Cátedra del Profesor Jeremías Snape • Certificación Oficial de Alquimia</div>

        <div class="stats-bar" id="stats-display">
            🔮 HISTORIAL DEL OPERARIO: Intento Actual N° 1
        </div>

        <div class="caldero-display" id="caldero">
            <div class="liquid" id="pocion-liquido"></div>
        </div>
        <div class="fire-burner" id="quemador"></div>

        <div class="console-box" id="consola">
            [SISTEMA]: Caldero de plata pura esterilizado y vacío. Esperando flujo inicial de reactivos...
        </div>

        <div class="controls-grid">
            <button id="btn-fuego" onclick="alternarFuego()">Encender Quemador (45°C)</button>
            <button id="btn-agua" onclick="agregarAgua()">Verter 500ml de Agua Destilada</button>
            <button id="btn-hongos" onclick="agregarHongos()">Incorporar Esporas de Hongo de Sombra</button>
            <button id="btn-mezclar" onclick="mezclarAntihorario()">Ejecutar Rotación Antihoraria (4 min)</button>
            <button id="btn-bilis" onclick="agregarBilis()">Añadir 2 Gotas de Bilis de Armadillo</button>
            
            <button id="btn-descargar" class="btn-action" onclick="descargarPDFResultados()" disabled>Descargar Pergamino Oficial (PDF)</button>
            
            <button id="btn-reiniciar" onclick="reiniciarLaboratorio()" style="grid-column: span 2; background-color: #1b1a1a; border-color: #333;">Limpiar Mesa de Trabajo (Siguiente Intento)</button>
        </div>
    </div>

    <div id="pdf-template">
        <div class="pdf-header">
            <div class="pdf-title">Pergamino Oficial de Certificación</div>
            <div class="pdf-subtitle">Hogwarts Orión • Registro de Logros de la Dirección de Mazmorras</div>
        </div>

        <div class="pdf-section">
            <div class="pdf-field">
                <span class="pdf-label">Asignatura del Castillo:</span>
                <span class="pdf-value">Pociones Avanzadas (Mesa Clínica N°1)</span>
            </div>
            <div class="pdf-field">
                <span class="pdf-label">Cátedra Regente:</span>
                <span class="pdf-value">Director Jeremías Snape</span>
            </div>
            <div class="pdf-field">
                <span class="pdf-label">Sustancia Ensayada:</span>
                <span class="pdf-value">Elíxir de Inversión de Entalpía Mágica</span>
            </div>
            <div class="pdf-field">
                <span class="pdf-label">Intentos Realizados:</span>
                <span class="pdf-value" id="pdf-intentos">1</span>
            </div>
            <div class="pdf-field">
                <span class="pdf-label">Estado de la Estructura:</span>
                <span class="pdf-value" id="pdf-estado">-</span>
            </div>
            <div class="pdf-field">
                <span class="pdf-label">Código de Validación:</span>
                <span class="pdf-value" id="pdf-codigo" style="font-family: monospace; font-weight: bold;">-</span>
            </div>
        </div>

        <div class="pdf-dictamen" id="pdf-dictamen-box">
            <span id="pdf-texto-dictamen">-</span>
        </div>

        <div class="pdf-footer">
            ~~••~~••~~• Documento Validado Bajo Sello Mágico Inquebrantable •๑۩⚗️۩๑•~~••~~••~~
        </div>
    </div>

    <script>
        // Variables de Control Interno
        let fuegoEncendido = false;
        let tieneAgua = false;
        let tieneHongos = false;
        let mezcladoCorrecto = false;
        let claseTerminada = false;
        
        let numeroIntentos = 1;
        let statusFinalPocion = "En proceso de destilación";
        let codigoValidacion = "[NINGUNO]";

        const consola = document.getElementById("consola");
        const liquido = document.getElementById("pocion-liquido");
        const quemador = document.getElementById("quemador");
        const interfaz = document.getElementById("lab-interface");
        const btnFuego = document.getElementById("btn-fuego");
        const btnDescargar = document.getElementById("btn-descargar");
        const statsDisplay = document.getElementById("stats-display");

        function actualizarConsola(texto) {
            consola.innerHTML += "<br>" + texto;
            consola.scrollTop = consola.scrollHeight;
        }

        function alternarFuego() {
            if (claseTerminada) return;
            fuegoEncendido = !fuegoEncendido;
            if (fuegoEncendido) {
                quemador.classList.add("on");
                btnFuego.innerText = "Apagar Quemador";
                actualizarConsola("[TÉRMICO]: Quemador activo. Temperatura de base fijada a 45°C.");
            } else {
                quemador.classList.remove("on");
                btnFuego.innerText = "Encender Quemador (45°C)";
                actualizarConsola("[TÉRMICO]: Fuente de calor disipada. Descenso gradual de entalpía.");
            }
        }

        function agregarAgua() {
            if (claseTerminada || tieneAgua) return;
            tieneAgua = true;
            document.getElementById("btn-agua").disabled = true;
            liquido.classList.add("agua");
            actualizarConsola("[QUÍMICO]: 500ml de fluido bendito destilado al vacío introducido.");
        }

        function agregarHongos() {
            if (claseTerminada || tieneHongos) return;
            if (!tieneAgua) {
                actualizarConsola("[ADVERTENCIA]: Las esporas se quemarán si las viertes en el metal seco.");
                return;
            }
            tieneHongos = true;
            document.getElementById("btn-hongos").disabled = true;
            liquido.className = "liquid hongo";
            actualizarConsola("[BIOLÓGICO]: Esporas de hongo de sombra añadidas. Tono gris opaco.");
        }

        function mezclarAntihorario() {
            if (claseTerminada) return;
            if (!tieneHongos) {
                actualizarConsola("[FALLO]: No hay densidad orgánica que organizar cinética.");
                return;
            }
            if (!fuegoEncendido) {
                actualizarConsola("[FALLO]: Las cadenas moleculares están congeladas. Requiere calor.");
                return;
            }
            mezcladoCorrecto = true;
            document.getElementById("btn-mezclar").disabled = true;
            actualizarConsola("[CINÉTICA]: Rotación antihoraria ejecutada. Alineación rúnica lograda.");
        }

        function agregarBilis() {
            if (claseTerminada) return;
            if (!mezcladoCorrecto) {
                actualizarConsola("[SNAOPE]: Añadir reactivos sin balancear la masa es un acto imprudente.");
                return;
            }

            document.getElementById("btn-bilis").disabled = true;
            claseTerminada = true;
            btnDescargar.disabled = false;

            // Procesamiento de resultados finales según el estado del fuego
            if (fuegoEncendido) {
                statusFinalPocion = "IMPLOSIÓN CATASTRÓFICA (Fracaso Crítico)";
                codigoValidacion = "[SNA-DESASTRE-FALLIDO]";
                interfaz.classList.add("implosion");
                consola.style.color = "#ec7063";
                actualizarConsola("<br>[🚨 CATASTROFE]: ¡IMPLOSIÓN DEL SISTEMA! La bilis reaccionó con el fuego activo. Coeficiente Ω colapsado.");
            } else {
                statusFinalPocion = "FILTRO ESTABILIZADO (Excelencia Absoluta)";
                codigoValidacion = "[SNAPEPOC1-OK]";
                liquido.className = "liquid esmeralda";
                consola.style.color = "#58d68d";
                actualizarConsola("<br>[🏆 EXCELENCIA]: Filtro Antitérmico de Snape Estabilizado de manera perfecta.");
            }

            // Guardar datos acumulados dentro del pergamino oculto para el PDF
            document.getElementById("pdf-intentos").innerText = numeroIntentos;
            document.getElementById("pdf-estado").innerText = statusFinalPocion;
            document.getElementById("pdf-codigo").innerText = codigoValidacion;
            
            const txtDictamen = document.getElementById("pdf-texto-dictamen");
            const boxDictamen = document.getElementById("pdf-dictamen-box");
            
            if (codigoValidacion === "[SNAPEPOC1-OK]") {
                boxDictamen.className = "pdf-dictamen";
                txtDictamen.innerHTML = "<strong>DICTAMEN DEL DIRECTOR:</strong> Excelente precisión molecular. El alumno demostró frialdad mental y respeto absoluto por las leyes del termómetro rúnico durante la destilación del Filtro Antitérmico en las Mazmorras del castillo. Calificación: Aprobado con Honores de Cátedra.";
            } else {
                boxDictamen.className = "pdf-dictamen fail";
                txtDictamen.innerHTML = "<strong>DICTAMEN DEL DIRECTOR:</strong> Incompetencia alarmante en el manejo de reactivos volátiles. El operario causó una inversión térmica catastrófica en el Coeficiente Ω por no mitigar la fuente de fuego antes de inyectar la bilis de armadillo. Calificación: Reprobado.";
            }
        }

        function descargarPDFResultados() {
            const elementoPDF = document.getElementById("pdf-template");
            
            // Hacemos el elemento visible temporalmente para que html2pdf pueda maquetarlo
            elementoPDF.style.display = "block";
            
            const opciones = {
                margin:       15,
                filename:     `Certificado_Mazmorras_Intento_${numeroIntentos}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, backgroundColor: '#0d1611' },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            // Iniciar captura y descarga del PDF
            html2pdf().set(opciones).from(elementoPDF).save().then(() => {
                // Volvemos a ocultar el bloque rúnico una vez descargado
                elementoPDF.style.display = "none";
            });
        }

        function reiniciarLaboratorio() {
            numeroIntentos++;
            statsDisplay.innerText = `🔮 HISTORIAL DEL OPERARIO: Intento Actual N° ${numeroIntentos}`;
            
            fuegoEncendido = false;
            tieneAgua = false;
            tieneHongos = false;
            mezcladoCorrecto = false;
            claseTerminada = false;
            statusFinalPocion = "En proceso de destilación";
            codigoValidacion = "[NINGUNO]";
            
            quemador.className = "fire-burner";
            liquido.className = "liquid";
            interfaz.className = "interface-container";
            consola.style.color = "#48c9b0";
            btnFuego.innerText = "Encender Quemador (45°C)";
            
            document.getElementById("btn-agua").disabled = false;
            document.getElementById("btn-hongos").disabled = false;
            document.getElementById("btn-mezclar").disabled = false;
            document.getElementById("btn-bilis").disabled = false;
            document.getElementById("btn-fuego").disabled = false;
            btnDescargar.disabled = true;
            
            consola.innerHTML = `[SISTEMA]: Mesa purificada. Iniciando intento número ${numeroIntentos}. Caldero listo.`;
        }
    </script>
</body>
</html>
